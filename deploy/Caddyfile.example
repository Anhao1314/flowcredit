# Replace api.example.com before deployment. The FlowCredit listener must be
# reachable only from this trusted proxy, never directly from the internet.
api.example.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy 127.0.0.1:8787
}
