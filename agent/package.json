{
  "name": "flowcredit-agent-sidecar",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:public-api": "node --test test/public-api.test.js",
    "test:finch-contract": "node --test test/finch-contract.test.js",
    "smoke:external-alpha": "node scripts/external-alpha-smoke.js",
    "eval:agent": "node eval/run-eval.js",
    "eval": "node ../quant/eval/run-eval.js",
    "console": "node ../quant/console/build.js",
    "serve": "node ../quant/agent/server.js",
    "paper": "node ../quant/paper/runner.js",
    "test:quant": "node --test ../quant/test/*.test.js",
    "check:quant": "node scripts/check-quant-isolation.js",
    "validate:public-api": "node scripts/validate-public-api.js",
    "validate:finch-contract": "node scripts/validate-finch-contract.js",
    "verify:release": "node scripts/verify-release.js",
    "verify:finch-submission": "node scripts/verify-finch-submission.js",
    "check": "npm run check:syntax && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "check:syntax": "node scripts/check-syntax.js",
    "propose": "node ../quant/proposals/generate.js",
    "adjudicate": "node ../quant/proposals/run-adjudication.js",
    "memory": "node ../quant/research-memory/build.js",
    "mcp": "node ../quant/agent/mcp-server.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "5.9.2"
  }
}
