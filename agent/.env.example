# Local Development
# Direct Node runs bind to loopback by default. Docker listens internally on
# CONTAINER_HOST and publishes only to PUBLISH_HOST.
# HOST=127.0.0.1
# PORT=8787
CONTAINER_HOST=0.0.0.0
PUBLISH_HOST=127.0.0.1
FC_SITE_ROOT=..
FC_RUNTIME_ROOT=../../fc-agent/runtime

# External Alpha / Public Deployment
# Keep the release identifier independent from API, intake and risk-engine versions.
FLOWCREDIT_RELEASE_VERSION=external-alpha-v0.1

# Required for public deployment. Use a managed, randomly generated secret of
# at least 16 characters. Never commit the populated .env file.
AUTH_ENABLED=true
FLOWCREDIT_API_KEY=

# Public gateway/container settings. Publish 8787 only to a trusted reverse
# proxy or private interface; clients should use HTTPS on the gateway.
HOST=0.0.0.0
PORT=8787
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
INVOCATION_TIMEOUT_MS=30000

# Enable only when direct access to Node is blocked and a trusted proxy
# overwrites X-Forwarded-For. Otherwise keep false.
TRUST_PROXY=false

# Single-instance External Alpha cache. Multi-instance deployment requires a
# shared Redis, database or KV implementation before scaling horizontally.
IDEMPOTENCY_TTL_MS=1800000
IDEMPOTENCY_MAX_ENTRIES=1000

# Optional LLM
# The deterministic engine does not depend on DeepSeek. Leave the key empty to
# run deterministic assessment only. Inject any real key through a managed
# secret or the documented DSH credential store, never through the image.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
